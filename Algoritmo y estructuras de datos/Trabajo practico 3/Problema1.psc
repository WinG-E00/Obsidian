Algoritmo Problema1
	
	Definir PreferenciaUsuario Como Caracter;
	
	Leer PreferenciaUsuario;

	Si (Mayusculas(PreferenciaUsuario) == "SI" )
		Escribir "A cursar al aula"
		
		SiNo
			Si(Mayusculas(PreferenciaUsuario) == "NO")
				Escribir "Enviaremos codigo de acceso"
				
			SiNo
				
				Escribir "Opcion incorrecta"
				
			FinSi
	FinSi
	
	
	
	
FinAlgoritmo
