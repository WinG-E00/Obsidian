Algoritmo Ejercicio11
	
	Definir cantidadDias, tiempoConsumido Como Entero;
	
	
	
	Escribir "escribe cantidad de dias"
	Leer cantidadDias
	
	
	
	tiempoConsumido <- (25*2) * cantidadDias;
	
	
	Escribir "La cantidad consumida de tiempo en minutos es de: ",tiempoConsumido ;
	Escribir "La cantidad de tiempo consumida en horas es de: ",tiempoConsumido / 60;
	
	
	
	
	
	//Conversion minutos a horas
	
	
FinAlgoritmo
