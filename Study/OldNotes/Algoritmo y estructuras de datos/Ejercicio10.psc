//El peso de equipo de sonido
//Volumen del proyector

//peso proyector
//Volumen equipo de sonido
Algoritmo Ejercicio10
	
	Definir pesoEquipoDeSonido, volumenProyector, pesoProyector, volumenEquipoDeSonido Como Real;
	
	
	Escribir "Escribe el peso del proyector";
	Leer  pesoEquipoDeSonido
	
	Escribir "Escribe el volumen del proyector";
	Leer volumenProyector
	
	
	
	pesoProyector <- pesoEquipoDeSonido / 3;
	
	volumenEquipoDeSonido <- volumenProyector * 3; 
	
	
	Escribir "Volumen equipo de sonido: ",volumenEquipoDeSonido;
	Escribir "Peso equipo de sonido: ",pesoEquipoDeSonido;
	Escribir "///////////////////////////////////////"
	Escribir "Volumen proyector: ",volumenProyector;
	Escribir "Peso proyector: ",pesoProyector;
	
	
	
	
	
	
	
	
FinAlgoritmo
