Funcion resultadoConversion <- centigrados_a_Fahrenheit(centigrados)
	resultadoConversion <- 9/5* centigrados+32;
FinFuncion


Algoritmo calculadora_Centigrados_Fahrenheit
	
	Definir grados Como Entero;
	
	Escribir "Escribe los grados que deseas convertir"
	Leer grados
	
	Escribir "El resultado de la conversion es: ", centigrados_a_Fahrenheit(grados);
	
	
FinAlgoritmo
