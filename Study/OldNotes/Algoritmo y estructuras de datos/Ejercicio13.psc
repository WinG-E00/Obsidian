Algoritmo Ejercicio13
	
	Definir cantidadSegundos Como Entero;
	
	Escribir "escribe una cantidad de segundos"
	Leer cantidadSegundos;
	
	Escribir "La cantidad de segundos es de ", cantidadSegundos;
	Escribir "La cantidad de segundos en horas seria: " (cantidadSegundos/ 60) / 60  ;
	Escribir "La cantidad de segundos a minutos seria:"  cantidadSegundos / 60;
	
	
	
	
	
	
FinAlgoritmo
